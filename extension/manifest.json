{
	"manifest_version": 3,
	"name": "Take Off Your Shorts",
	"version": "0.3.0",
	"description": "Удаляет элементы YouTube Shorts",
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"action": {
		"default_title": "Take Off Your Shorts",
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon16.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"content_scripts": [
		{
			"matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
			"css": ["styles.css"],
			"run_at": "document_idle"
		}
	]
}
